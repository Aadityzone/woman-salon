# MongoDB Atlas connection string. Keep secrets out of Git.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/maison_belle
# Generate a random secret of at least 32 characters.
OWNER_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
OWNER_EMAIL=owner@example.com
# Generate with: node -e "require('bcryptjs').hash('your-password', 12).then(console.log)"
OWNER_PASSWORD_HASH=replace-with-bcrypt-hash
# Public salon details are placeholders until the owner confirms them.
NEXT_PUBLIC_SALON_NAME=Maison Belle
NEXT_PUBLIC_SALON_PHONE=
NEXT_PUBLIC_SALON_ADDRESS=
NEXT_PUBLIC_SALON_HOURS=10:00 AM – 7:00 PM
SALON_OPEN_TIME=10:00
SALON_CLOSE_TIME=19:00
# Optional stylist names and schedules. Days use comma-separated Sun,Mon,Tue,Wed,Thu,Fri,Sat.
SALON_STAFF_1_NAME=Stylist 1
SALON_STAFF_1_DAYS=Mon,Tue,Wed,Thu,Fri,Sat,Sun
SALON_STAFF_1_OPEN_TIME=10:00
SALON_STAFF_1_CLOSE_TIME=19:00
SALON_STAFF_2_NAME=Stylist 2
SALON_STAFF_2_DAYS=Mon,Tue,Wed,Thu,Fri,Sat,Sun
SALON_STAFF_2_OPEN_TIME=10:00
SALON_STAFF_2_CLOSE_TIME=19:00

# Optional server-to-server webhook for new confirmed appointments (keep private).
# Configure this with a trusted automation endpoint to notify the salon owner.
OWNER_NOTIFICATION_WEBHOOK=
